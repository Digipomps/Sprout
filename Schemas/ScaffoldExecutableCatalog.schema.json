{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haven.local/sprout/schemas/ScaffoldExecutableCatalog.schema.json",
  "title": "ScaffoldExecutableCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog_id",
    "scaffold_domain",
    "issued_at",
    "expires_at",
    "issued_by",
    "artifacts",
    "signature"
  ],
  "properties": {
    "version": { "type": "string" },
    "catalog_id": { "type": "string" },
    "scaffold_domain": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "name",
          "kind",
          "platform",
          "semver",
          "channel",
          "download_url",
          "sha256_b64url",
          "signing"
        ],
        "properties": {
          "artifact_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "platform": { "type": "string" },
          "semver": { "type": "string" },
          "channel": { "type": "string" },
          "download_url": { "type": "string", "format": "uri" },
          "sha256_b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "size_bytes": { "type": "integer" },
          "release_manifest_url": { "type": "string", "format": "uri" },
          "checksum_url": { "type": "string", "format": "uri" },
          "sbom_url": { "type": "string", "format": "uri" },
          "provenance_url": { "type": "string", "format": "uri" },
          "signing": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "certificate_url": { "type": "string", "format": "uri" },
                "identity": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "type": "string", "const": "Ed25519" },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  }
}
