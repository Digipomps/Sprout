{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haven.local/sprout/schemas/NativePortholeBindingDescriptor.schema.json",
  "title": "NativePortholeBindingDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridge_endpoint",
    "bridge_websocket_url",
    "cell_endpoint",
    "contract_id",
    "contract_payload_b64url",
    "contract_sha256_b64url",
    "scaffold_domain",
    "entity_id",
    "identity_public_key",
    "scaffold_admin_public_key",
    "capability_grants",
    "expires_at"
  ],
  "properties": {
    "bridge_endpoint": { "type": "string" },
    "bridge_websocket_url": { "type": "string", "format": "uri" },
    "cell_endpoint": { "type": "string" },
    "contract_id": { "type": "string" },
    "contract_payload_b64url": { "type": "string" },
    "contract_sha256_b64url": { "type": "string" },
    "scaffold_domain": { "type": "string" },
    "entity_id": { "type": "string" },
    "identity_public_key": { "type": "string" },
    "scaffold_admin_public_key": { "type": "string" },
    "capability_grants": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
