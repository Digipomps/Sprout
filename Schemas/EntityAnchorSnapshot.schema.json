{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haven.local/sprout/schemas/EntityAnchorSnapshot.schema.json",
  "title": "EntityAnchorSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "scaffold_domain",
    "admin_public_key",
    "issued_at",
    "expires_at",
    "entities",
    "signature"
  ],
  "properties": {
    "snapshot_id": { "type": "string" },
    "scaffold_domain": { "type": "string" },
    "admin_public_key": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "identities", "accepted_entity_link_contract_ids"],
        "properties": {
          "entity_id": { "type": "string" },
          "identities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identity_public_key", "domain", "added_at"],
              "properties": {
                "identity_public_key": { "type": "string" },
                "domain": { "type": "string" },
                "added_at": { "type": "string", "format": "date-time" },
                "source_contract_id": { "type": "string" }
              }
            }
          },
          "accepted_entity_link_contract_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": {
          "type": "string",
          "enum": ["Ed25519"]
        },
        "sig": {
          "type": "string"
        }
      }
    }
  }
}
